DATABASE_URL="mysql://mothers:mothers123@localhost:3306/mothers_team"
JWT_SECRET="change-me-in-production-min-32-chars"
REFRESH_SECRET="change-me-too-in-production-min-32-chars"
FRONTEND_URL="http://localhost:5173"
PORT=3001
NODE_ENV=development

# Firebase Cloud Messaging (FCM)
# JSON completo da service account em base64url (sem chars problemáticos em env files)
# python: base64.urlsafe_b64encode(open('firebase-sa.json','rb').read()).decode()
FIREBASE_SERVICE_ACCOUNT_B64=

# ElevenLabs (Sara voice)
ELEVENLABS_AGENT_ID=
ELEVENLABS_VOICE_ID=

# Gemini (Sara text chat)
GEMINI_API_KEY=

# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM="Mothers Team <noreply@santoti.com>"
